# Deploys from the repository root (both Vercel projects are connected to
# the repo: berth builds site/, berth-docs builds docs-site/, which reads
# ../docs and site/assets/fonts). Only those folders need to upload.
/*
!/docs
!/docs-site
!/site
/site/scripts
/site/README.md
/site/.env*
/site/.vercel
/docs-site/node_modules
/docs-site/.next
