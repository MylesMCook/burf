{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Berth",
  "app": {
    "windows": [
      {
        "title": "Berth",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/sean-brydon/berthd/releases/latest/download/latest-windows.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
