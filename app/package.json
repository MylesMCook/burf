{
  "name": "burf",
  "private": true,
  "version": "0.3.12",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-plugins.mjs && vite",
    "build": "node scripts/build-plugins.mjs && tsc && vite build",
    "preview": "vite preview",
    "build:demo": "node scripts/build-plugins.mjs && tsc && vite build --mode demo",
    "build:plugins": "node scripts/build-plugins.mjs",
    "typecheck:plugins": "tsc --noEmit -p ../plugins",
    "check:titles": "node scripts/check-titles.mjs",
    "check:plugin-consent": "node scripts/check-plugin-consent.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:themes": "node --experimental-strip-types --test src/themes/contrast.test.ts",
    "test:platform": "node --experimental-strip-types --test src/lib/platform.test.ts",
    "test:e2e": "tsc --noEmit -p e2e && pnpm run build && playwright test",
    "smoke:live": "node e2e/live.mjs",
    "perf": "node perf/bench.mjs",
    "perf:guard": "node perf/guard.mjs",
    "perf:soak": "node perf/soak.mjs",
    "perf:terminals": "node perf/terminals.mjs",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\" \"src/components/**/*.test.ts\" \"src/hooks/**/*.test.ts\" \"src/views/**/*.test.ts\" && node --test ../scripts/ui-manifest.test.mjs",
    "dev:feedback": "node wails-feedback/run.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.25",
    "@assistant-ui/react-markdown": "^0.14.19",
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@lezer/highlight": "^1.2.5",
    "@number-flow/react": "0.6.2",
    "@pierre/diffs": "^1.5.1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@visx/curve": "4.0.1-alpha.0",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/group": "4.0.1-alpha.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/sankey": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "@wailsio/runtime": "3.0.0-beta.28",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-array": "3.2.4",
    "d3-sankey": "0.12.3",
    "d3-shape": "3.2.0",
    "diff": "9.0.0",
    "ghostty-web": "^0.4.0",
    "katex": "0.16.47",
    "lucide-react": "^1.48.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "14.0.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-shape": "3.1.7",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.25.12",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "agentation": "3.1.2",
    "agentation-mcp": "1.3.2"
  }
}
